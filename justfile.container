# angzarr-router — container-side recipes.
#
# Mounted over `justfile` inside the container (and used directly inside a
# devcontainer). Holds the real toolchain invocations; the host `justfile`
# delegates here via the container-overlay pattern (same as angzarr core).
set shell := ["bash", "-c"]

# The checkout root: this file sits at the top (mounted over `justfile` in the
# container, read in place in a devcontainer). Independent of git, so a git
# worktree whose .git points outside the mount works too.
TOP := justfile_directory()

# cargo-mutants, installed into the persisted CARGO_HOME when the rust image
# lacks it (no published image ships it).
CARGO_MUTANTS := "27.1.0"

default:
    @just --list

# Build the workspace
build:
    cargo build --manifest-path {{TOP}}/Cargo.toml --workspace

# Run the unit test bank
test:
    cargo test --manifest-path {{TOP}}/Cargo.toml --workspace

# The wasm test runner, pinned to the wasm-bindgen in Cargo.lock (the CLI
# and the library must match exactly; the same pin as angzarr-ports').
WASM_BINDGEN := "0.2.129"
# The node the runner runs the tests under: an official release, verified
# against its published SHA-256, unpacked into .tools/ (the rust image has
# no node).
NODE := "22.22.2"
NODE_SHA256_X64 := "88fd1ce767091fd8d4a99fdb2356e98c819f93f3b1f8663853a2dee9b438068a"
NODE_SHA256_ARM64 := "e9e1930fd321a470e29bb68f30318bf58e3ecb4acb4f1533fb19c58328a091fe"

# Install what the wasm tests need beyond the image: the wasm32 target,
# wasm-bindgen-test-runner (into CARGO_HOME) and node (into .tools/).
wasm-tools:
    #!/usr/bin/env bash
    set -euo pipefail
    # cargo install puts the runner in CARGO_HOME's bin, which the image's
    # PATH lacks when CARGO_HOME is the overlay's (.cargo-container).
    export PATH="${CARGO_HOME:-$HOME/.cargo}/bin:$PATH"
    rustup target list --installed | grep -qx wasm32-unknown-unknown || rustup target add wasm32-unknown-unknown
    have="$(wasm-bindgen-test-runner --version 2>/dev/null | awk '{print $2}' || true)"
    if [ "$have" != "{{WASM_BINDGEN}}" ]; then
        cargo install --locked wasm-bindgen-cli --version {{WASM_BINDGEN}}
    fi
    locked="$(grep -A1 '^name = "wasm-bindgen"$' {{TOP}}/Cargo.lock | sed -n 's/^version = "\(.*\)"/\1/p')"
    [ "$locked" = "{{WASM_BINDGEN}}" ] || { echo "Cargo.lock has wasm-bindgen $locked; WASM_BINDGEN is {{WASM_BINDGEN}}: bump them together" >&2; exit 1; }
    case "$(uname -m)" in
        x86_64) arch=x64; sum={{NODE_SHA256_X64}} ;;
        aarch64) arch=arm64; sum={{NODE_SHA256_ARM64}} ;;
        *) echo "no pinned node for $(uname -m)" >&2; exit 1 ;;
    esac
    dir="{{TOP}}/.tools/node-v{{NODE}}-linux-$arch"
    if [ ! -x "$dir/bin/node" ]; then
        mkdir -p "{{TOP}}/.tools"
        tarball="$dir.tar.xz"
        curl -fsSL -o "$tarball" "https://nodejs.org/dist/v{{NODE}}/node-v{{NODE}}-linux-$arch.tar.xz"
        echo "$sum  $tarball" | sha256sum -c --quiet -
        tar -xJf "$tarball" -C "{{TOP}}/.tools"
        rm -f "$tarball"
    fi

# Build the router for wasm32, compile all its wasm32 tests, and run
# tests/wasm.rs (components that are not Send, an Rc held across an await)
# under node with wasm-bindgen-test-runner.
wasm: wasm-tools
    #!/usr/bin/env bash
    set -euo pipefail
    case "$(uname -m)" in x86_64) arch=x64 ;; aarch64) arch=arm64 ;; esac
    export PATH="{{TOP}}/.tools/node-v{{NODE}}-linux-$arch/bin:${CARGO_HOME:-$HOME/.cargo}/bin:$PATH"
    cargo build --manifest-path {{TOP}}/Cargo.toml -p angzarr-router --target wasm32-unknown-unknown
    cargo test --manifest-path {{TOP}}/Cargo.toml -p angzarr-router --target wasm32-unknown-unknown --no-run
    CARGO_TARGET_WASM32_UNKNOWN_UNKNOWN_RUNNER=wasm-bindgen-test-runner cargo test --manifest-path {{TOP}}/Cargo.toml -p angzarr-router --target wasm32-unknown-unknown --test wasm

# Check formatting (no rewrite; fails on drift)
fmt-check:
    cargo fmt --manifest-path {{TOP}}/Cargo.toml --all --check

# The files held to mutation testing: the core modules and the architecture
# linter. Their threshold is 100%:
# any missed (or timed-out) mutant fails `mutation-test` and `mutation-diff`
# (cargo-mutants exits non-zero); only a genuinely equivalent mutant may be
# excluded, in .cargo/mutants.toml, with the argument for its equivalence.
MUTATED := "-f crates/router/src/rebuild.rs -f crates/router/src/domain.rs -f crates/router/src/context.rs -f crates/router/src/projector.rs -f crates/router/src/policy.rs -f crates/router/src/error.rs -f crates/router/src/lib.rs -f crates/router/src/router.rs -f tools/archlint/src/rules.rs -f tools/archlint/src/scan.rs -f tools/archlint/src/workspace.rs -f tools/archlint/src/model.rs"

# Mutation-test every file in MUTATED: the full pass.
# cargo-mutants copies the source tree, so the proto root must be an absolute
# path that survives the copy — ANGZARR_PROJECT_PROTO points build.rs at the
# real submodule checkout.
mutation-test:
    cargo mutants --version >/dev/null 2>&1 || cargo install cargo-mutants --locked --version {{CARGO_MUTANTS}}
    cd {{TOP}} && ANGZARR_PROJECT_PROTO=${ANGZARR_PROJECT_PROTO:-{{TOP}}/angzarr-project/proto} cargo mutants {{MUTATED}} --timeout 120

# Mutation-test only the lines of MUTATED that the diff PATCH (relative to the
# checkout, a/ and b/ paths, this tree's lines on the b side) changes, held to
# the same 100%: the host `mutation-push`'s run, in the pushed commit's tree.
# cargo-mutants' exit code is the verdict (4: the tests fail unmutated). Its
# mutants.out is target/mutants-push/mutants.out.
mutation-diff PATCH:
    cargo mutants --version >/dev/null 2>&1 || cargo install cargo-mutants --locked --version {{CARGO_MUTANTS}}
    cd {{TOP}} && ANGZARR_PROJECT_PROTO=${ANGZARR_PROJECT_PROTO:-{{TOP}}/angzarr-project/proto} cargo mutants {{MUTATED}} --in-diff {{PATCH}} --timeout 120 --output target/mutants-push

# Format
fmt:
    cargo fmt --manifest-path {{TOP}}/Cargo.toml --all

# Lint (clippy, warnings are errors)
lint:
    cargo clippy --manifest-path {{TOP}}/Cargo.toml --workspace --all-targets -- -D warnings

# Architecture lint: check the workspace's module dependency graph against
# the layer rules in archlint.toml (tools/archlint). `cargo run -p archlint --
# --edges` prints the model the rules are checked against.
archlint:
    cargo run --manifest-path {{TOP}}/Cargo.toml --quiet -p archlint -- --rules {{TOP}}/archlint.toml --manifest-path {{TOP}}/Cargo.toml
